HOST=0.0.0.0
PORT=8010
CORS_ORIGINS=http://localhost:5174

# Ollama (VLM) settings -- reuses the same server the vlm_testing/ project talks to.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:latest
OLLAMA_KEEP_ALIVE=-1

# YOLO person detector. yolo12n.pt auto-downloads on first run if not already
# cached locally (same pattern as persontraking_project/config/config.yaml).
YOLO_WEIGHTS=yolo12n.pt
YOLO_DEVICE=auto
YOLO_CONF=0.35
YOLO_IOU=0.5
YOLO_IMGSZ=640

STORAGE_DIR=./storage

# Crop around each detected person sent to the VLM: fraction of the box added on every
# side (0.15 = 15%). Bigger keeps bags and carried items in view but costs more VLM time.
CROP_PADDING_RATIO=0.15
MIN_CROP_AREA_PX=3000

# Clicking a person's timeline plays the crop moment +/- this many seconds.
PLAYBACK_WINDOW_SEC=3.0

# Gemini chat assistant (answers questions over every saved video result).
# Get a key at https://aistudio.google.com/apikey and paste it below -- the
# /api/chat endpoint returns a clear error until this is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com

# Person re-identification: merges the several ByteTrack ids one real person gets
# (they leave view and come back) so each person is sent to the VLM once.
# Needs the optional `torchreid` package -- without it (or REID_ENABLED=false) the
# pipeline uses one crop per track, as before. See howtosetup.md.
REID_ENABLED=true
REID_MODEL_NAME=osnet_x1_0
# Path to a re-ID-TRAINED OSNet checkpoint (Market1501/MSMT17), relative to backend/.
# Empty falls back to ImageNet weights, which are NOT trained to tell people apart.
REID_MODEL_PATH=models/osnet_x1_0_msmt17.pth
# cpu keeps the GPU's VRAM free for the Qwen VLM. auto | cpu | cuda
REID_DEVICE=cpu
# Cosine similarity to merge two tracks: 0.72 conservative (default), 0.55 aggressive.
REID_MERGE_THRESHOLD=0.72
REID_CROPS_PER_TRACK=3
# Tracks seen together in more than this many frames are never merged.
REID_MAX_CO_FRAMES=0
